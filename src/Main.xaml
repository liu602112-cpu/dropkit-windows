<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropKit · Windows" Width="420" Height="560" MinWidth="360" MinHeight="360" WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" Foreground="#26344B" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" AllowDrop="True" ShowInTaskbar="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#3E63DD"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#90FFFFFF"/><Setter Property="Foreground" Value="#43516A"/>
      <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="2"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#90FFFFFF"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EAF0FF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3E63DD"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#9FFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#90FFFFFF"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#849EEA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,9"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="Switch" Width="30" Height="18" CornerRadius="9" Background="#BCC6D6" HorizontalAlignment="Left"><Border x:Name="Knob" Width="12" Height="12" CornerRadius="6" Background="White" HorizontalAlignment="Left" Margin="3"/></Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="#5274DC"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="#26344B"/><Setter TargetName="Switch" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#66909FB8" CornerRadius="3" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#70FFFFFF"/><Setter Property="BorderBrush" Value="#90FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#70FFFFFF" BorderBrush="#90FFFFFF" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,2" Foreground="#70819C"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,4,24,4" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#F5F8FE" CornerRadius="9" Padding="4" MinWidth="90" BorderBrush="#DDE5F2" BorderThickness="1"><ScrollViewer CanContentScroll="True" MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3,4"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Card" CornerRadius="12" Background="#A6FFFFFF" BorderBrush="#AAFFFFFF" BorderThickness="1" Padding="10"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#9DB0EF"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#EDF2FF"/><Setter TargetName="Card" Property="BorderBrush" Value="#3E63DD"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="FileGrid">
      <StackPanel Width="135" ToolTip="{Binding Path}">
        <Grid Height="62" Margin="0,2,0,10">
          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#6682DA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
        </Grid>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Detail}" Foreground="#8590A3" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="FileList">
      <Grid ToolTip="{Binding Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,10,0"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#6682DA" VerticalAlignment="Center"/><Image Source="{Binding Thumbnail}" MaxHeight="40"/></Grid>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#8590A3" FontSize="11" Margin="0,4,0,0"/></StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ClipCard">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Width="26" Height="26" CornerRadius="8" Background="#90E8EEFF" VerticalAlignment="Top"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="#5974C3" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1">
          <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Meta}" Foreground="#77859D" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Uid="CopyEntry" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="23" Height="22" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="复制这条记录" AutomationProperties.Name="复制这条记录"/><Button Uid="DeleteEntry" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="23" Height="22" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="删除这条记录" AutomationProperties.Name="删除这条记录"/></StackPanel></Grid>
          <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" MaxHeight="57" TextTrimming="CharacterEllipsis" LineHeight="19"/>
          <Border Height="108" Background="#70E7EDF5" CornerRadius="8" Margin="0,5,0,0" ClipToBounds="True">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasMediaPreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="GlassSurface" CornerRadius="16" Background="#5CF2F6FC" BorderBrush="#BFFFFFFF" BorderThickness="1">
  <Grid Margin="15,13,15,11" x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12" x:Name="Header" Background="Transparent" Cursor="SizeAll"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Background="#5274DC" CornerRadius="10" Width="34" Height="34"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="DropKit" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="随手收集，轻松取用" Foreground="#7E8DA5" FontSize="10"/></StackPanel>
        <Border Background="#80FFFFFF" CornerRadius="5" Margin="12,0,0,0" Padding="7,3" VerticalAlignment="Center"><TextBlock Text="F4" Foreground="#7B89A1" FontSize="10"/></Border>
      </StackPanel>
      <Button Grid.Column="1" x:Name="HideButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Width="30" Height="30" Padding="0" VerticalAlignment="Center" ToolTip="收起到托盘，F4 再次打开" AutomationProperties.Name="收起到托盘"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,12" Background="#38C6D1E7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="ShelfTab" Content="文件暂存" FontWeight="SemiBold"/>
      <Button Grid.Column="1" x:Name="HistoryTab" Content="剪贴板" FontWeight="SemiBold"/>
      <Button Grid.Column="2" x:Name="SettingsTab" Content="设置" FontWeight="SemiBold"/>
    </Grid>
    <Grid Grid.Row="2" x:Name="ShelfPage">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,9">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ViewButton" Content="列表" Padding="7,6"/><Button x:Name="CompactButton" Content="紧凑" Padding="7,6"/><Button x:Name="AddLinkButton" Content="网站" Padding="7,6" ToolTip="粘贴 Pinterest 素材链接并保存"/><Button x:Name="AddButton" Content="＋" Padding="7,6" ToolTip="添加文件"/></StackPanel>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ShelfCount" Text="文件暂存" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ShelfSubtitle" Text="Ctrl + Shift + S" Foreground="#8590A3" FontSize="11" Margin="0,4,0,0"/></StackPanel>
      </DockPanel>
      <Border Grid.Row="1" BorderBrush="#A0FFFFFF" BorderThickness="1" CornerRadius="12" Background="#35EDF2FA" x:Name="DropSurface">
        <Grid>
          <ListBox x:Name="FileList" SelectionMode="Extended" ItemTemplate="{StaticResource FileGrid}" Margin="6"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
          <StackPanel x:Name="ShelfEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="14">
            <Border Background="White" CornerRadius="18" Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,18"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#3E63DD" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="把文件放在这里" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="拖进来暂存，再拖到需要的地方" Foreground="#7C89A1" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="拖着可保存的内容左右晃动，即可唤出" Foreground="#97A1B2" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
      <WrapPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right"><Button x:Name="SelectFilesButton" Content="全选" Padding="7,7"/><Button x:Name="CopyFilesButton" Content="复制" Padding="7,7"/><Button x:Name="RemoveFilesButton" Content="仅移除" Padding="7,7" ToolTip="只移除暂存记录，保留文件"/><Button x:Name="DeleteFilesButton" Content="删除选中" Padding="7,7" ToolTip="将选中的原文件移到回收站"/><Button x:Name="DeleteAllFilesButton" Content="全部删除" Padding="7,7" Foreground="#A84A56" ToolTip="全部暂存原文件移到回收站"/></WrapPanel>
    </Grid>
    <Grid Grid.Row="2" x:Name="HistoryPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid><TextBox x:Name="SearchBox" ToolTip="搜索文本、链接或文件路径" AutomationProperties.Name="搜索剪贴板"/>
          <TextBlock Text="搜索文本、链接、文件…" Foreground="#97A1B2" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <Button Grid.Column="1" x:Name="PauseButton" Content="暂停" ToolTip="暂停或恢复记录" Margin="6,0,0,0"/>
      </Grid>
      <DockPanel Grid.Row="1" Margin="0,8,0,7"><TextBlock x:Name="HistoryCount" DockPanel.Dock="Right" Foreground="#8590A3" FontSize="10" VerticalAlignment="Center" Margin="5,0"/><ComboBox x:Name="FilterBox" Visibility="Collapsed"><ComboBoxItem Content="全部" IsSelected="True"/><ComboBoxItem Content="文字"/><ComboBoxItem Content="链接"/><ComboBoxItem Content="图片"/><ComboBoxItem Content="文件"/><ComboBoxItem Content="固定"/></ComboBox><StackPanel Orientation="Horizontal"><Button x:Name="AllFilterButton" Content="全部" Padding="9,5" BorderThickness="0"/><Button x:Name="ImageFilterButton" Content="图片" Padding="9,5" BorderThickness="0"/><Button x:Name="TextFilterButton" Content="文字" Padding="9,5" BorderThickness="0" ToolTip="文字和链接"/><Button x:Name="FileFilterButton" Content="文件" Padding="9,5" BorderThickness="0"/><Button x:Name="PinnedFilterButton" Content="固定" Padding="9,5" BorderThickness="0"/></StackPanel></DockPanel>
      <WrapPanel Grid.Row="2" x:Name="ImageActions" Margin="0,0,0,6"><TextBlock x:Name="ImageCount" Foreground="#718099" FontSize="10" VerticalAlignment="Center" Margin="3,0,6,0"/><Button x:Name="SelectImagesButton" Content="全选图片" Padding="8,6"/><Button x:Name="CopyAllImagesButton" Content="复制全部" Padding="8,6" Background="#ACDFE8FF" ToolTip="复制当前分类和搜索结果中的全部图片"/><Button x:Name="SaveImagesButton" Content="保存图片…" Padding="8,6" ToolTip="保存当前分类中全部或选中的图片"/></WrapPanel>
      <Grid Grid.Row="3"><ListBox x:Name="ClipList" SelectionMode="Extended" ItemTemplate="{StaticResource ClipCard}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
        <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Grid Margin="5,9,5,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#637694"/><TextBlock Text="{Binding ItemCount, StringFormat=  ·  {0} 条}" FontSize="10" Foreground="#8590A3" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Uid="CopyDay" Tag="{Binding Name}" Content="复制" Padding="7,3" FontSize="10" Background="Transparent" BorderThickness="0" ToolTip="复制这天当前分类的记录"/><Button Uid="DeleteDay" Tag="{Binding Name}" Content="删除" Padding="7,3" FontSize="10" Background="Transparent" BorderThickness="0" ToolTip="删除这天当前分类的记录"/></StackPanel></Grid></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
      </ListBox><StackPanel x:Name="HistoryEmpty" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Foreground="#94A7DC" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,18"/><TextBlock x:Name="EmptyHistoryTitle" Text="从下一次复制开始" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="文本、图片与文件，都可以在这里找回" Foreground="#8590A3" FontSize="12" Margin="0,10,0,0"/></StackPanel></Grid>
      <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,7,0,0"><Button x:Name="PreviewButton" Content="预览" Padding="7,7"/><Button x:Name="PinButton" Content="固定" Padding="7,7" ToolTip="固定 / 取消固定"/><Button x:Name="DeleteClipButton" Content="删除" Padding="7,7" ToolTip="选中内容移到回收站"/><Button x:Name="CopyClipButton" Content="复制" Padding="7,7" ToolTip="复制所选内容" Background="#B8E0E9FF"/><Button x:Name="PasteButton" Content="粘贴" Padding="7,7" ToolTip="粘贴到之前的窗口"/><Button x:Name="DeleteAllClipsButton" Content="全部删除" Padding="7,7" Foreground="#A84A56" ToolTip="全部历史（含固定）关联文件移到回收站"/></WrapPanel>
    </Grid>
    <ScrollViewer Grid.Row="2" x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="3,0,8,8">
        <TextBlock Text="按你的习惯工作" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Border Background="#80FFFFFF" CornerRadius="12" Padding="12" BorderBrush="#A0FFFFFF" BorderThickness="1"><StackPanel>
          <TextBlock Text="启动与窗口" FontWeight="SemiBold" Margin="0,0,0,5"/>
          <CheckBox x:Name="StartupCheck" Content="登录 Windows 时自动启动"/>
          <TextBlock x:Name="StartupStatus" Foreground="#657EA9" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5"/>
          <CheckBox x:Name="ShakeCheck" Content="拖着文件、图片或文字晃动时唤出"/>
          <CheckBox x:Name="TopmostCheck" Content="窗口保持在最前面"/>
          <TextBlock Text="Ctrl + Shift + S  文件暂存    /    F4  打开或收起" Foreground="#78859C" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
          <TextBlock x:Name="HotkeyStatus" Foreground="#657EA9" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel></Border>
        <Border Background="#80FFFFFF" CornerRadius="12" Padding="12" Margin="0,10,0,0" BorderBrush="#A0FFFFFF" BorderThickness="1"><StackPanel>
          <TextBlock Text="剪贴板与隐私" FontWeight="SemiBold"/>
          <CheckBox x:Name="CaptureCheck" Content="记录新复制的文本、图片和文件"/>
          <WrapPanel Margin="0,5,0,9"><TextBlock Text="最多保留" VerticalAlignment="Center"/><TextBox x:Name="LimitBox" Width="75" Margin="10,0"/><TextBlock Text="条    保留" VerticalAlignment="Center"/><TextBox x:Name="DaysBox" Width="65" Margin="10,0"/><TextBlock Text="天" VerticalAlignment="Center"/></WrapPanel>
          <TextBlock Text="0 表示不限；固定内容不受自动清理影响。普通记录另有 64 MB 容量上限。" FontSize="11" Foreground="#8590A3" TextWrapping="Wrap"/>
          <TextBlock Text="不记录这些应用（进程名，用分号分隔）" Margin="0,15,0,7"/>
          <TextBox x:Name="ExcludedBox" TextWrapping="Wrap" MinHeight="65"/>
          <TextBlock Text="历史仅保存在本机，并由当前 Windows 账户加密。会跳过带保密标记的内容；不带标记的密码仍可能被记录，可随时暂停。" FontSize="11" Foreground="#8590A3" TextWrapping="Wrap" Margin="0,9,0,5"/>
          <WrapPanel><Button x:Name="ClearHistoryButton" Content="全部删除到回收站…"/><Button x:Name="DataFolderButton" Content="打开数据文件夹"/><Button x:Name="ExportFolderButton" Content="打开图片导出文件夹"/><Button x:Name="WebsiteFolderButton" Content="打开网站素材文件夹"/></WrapPanel>
        </StackPanel></Border>
        <Border Background="#80FFFFFF" CornerRadius="12" Padding="12" Margin="0,10,0,0" BorderBrush="#A0FFFFFF" BorderThickness="1"><StackPanel>
          <TextBlock Text="文件夹收件箱" FontWeight="SemiBold"/><CheckBox x:Name="WatchCheck" Content="将所选文件夹中的新文件自动加入暂存"/>
          <DockPanel><Button x:Name="ChooseFolderButton" Content="选择文件夹" DockPanel.Dock="Right"/><TextBox x:Name="WatchPathBox" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
        </StackPanel></Border>
        <Button x:Name="SaveSettingsButton" Content="保存保留规则" ToolTip="开关立即保存；这里保存条数、天数和排除应用" Background="#A8DFE8FF" Foreground="#3154BD" FontWeight="SemiBold" Margin="0,15,0,10" Padding="14,11"/>
        <TextBlock Text="DropKit Windows 1.5 · 社区移植版&#x0a;chenyuxiaojin/DropKit · MIT" Foreground="#97A1B2" FontSize="10" LineHeight="17" TextAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="#80FFFFFF" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0"><DockPanel><Button x:Name="UndoDeleteButton" DockPanel.Dock="Right" Content="回收站" FontSize="10" Padding="7,3" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="就绪 · 仅在本机保存" Foreground="#7B89A1" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
    <Border Grid.Row="2" x:Name="DropOverlay" Visibility="Collapsed" Background="#EBF1FF" BorderBrush="#3E63DD" BorderThickness="2" CornerRadius="12" IsHitTestVisible="False"><TextBlock x:Name="DropHint" Text="松开鼠标，加入暂存" Foreground="#3E63DD" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
  </Grid>
  </Border>
</Window>
